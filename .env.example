# Preferred: the entire perplexity.ai Cookie header, including
# cf_clearance, __cf_bm, and __Secure-next-auth.session-token.
# A session token alone is often blocked by Cloudflare.
PERPLEXITY_COOKIES=

# Optional fallback if you only have the session token.
PERPLEXITY_SESSION_TOKEN=

# Optional official Sonar API key. Used only when the unofficial
# WebUI path is blocked (for example by Cloudflare).
PERPLEXITY_API_KEY=

# Bind address for `npm run dev`
PORT=43147

# Optional Perplexity WebUI session cookie value
# (__Secure-next-auth.session-token from perplexity.ai).
# Leave empty to try anonymous free queries.
PERPLEXITY_SESSION_TOKEN=

# Optional official Sonar API key. Used only when the unofficial
# WebUI path is blocked (for example by Cloudflare).
PERPLEXITY_API_KEY=

# Bind address for `npm run dev`
PORT=43147
